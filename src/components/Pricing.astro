---
// Цены: две узкие карточки услуг рядом (на мобильных — друг под другом), без сумм.
// Наведение: карточка приподнимается, рамка светлеет, за курсором плывёт мягкий белый отсвет.
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';
import SectionTitle from './SectionTitle.astro';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Иконки строк по индексу карточки: [0] дизайн превью, [1] пакет для A/B-теста
const featureIcons: IconName[][] = [
  ['image', 'clock', 'refresh'],
  ['layers', 'clock', 'refresh'],
];
const fallbackIcons: IconName[] = ['image', 'clock', 'refresh'];

// Выделить число срока («24-hour», «24 часа») — без цвета, просто плотнее и белее
type Split = { before: string; strong: string; after: string };
const splitNumber = (text: string): Split | null => {
  const m = /\d+(?:[-\u2011]\p{L}+|\s\p{L}+)?/u.exec(text);
  if (!m) return null;
  return {
    before: text.slice(0, m.index),
    strong: m[0],
    after: text.slice(m.index + m[0].length),
  };
};

const cards = t.pricing.cards.map((card, i) => {
  const icons = featureIcons[i] ?? fallbackIcons;
  return {
    title: card.title,
    index: String(i + 1).padStart(2, '0'),
    titleId: `pricing-card-${i + 1}-title`,
    chipIcon: icons[0] ?? 'image',
    features: card.features.map((text, j) => {
      const icon: IconName = icons[j] ?? 'check';
      return { text, icon, split: icon === 'clock' ? splitNumber(text) : null };
    }),
  };
});

// Строки общей сетки карточек (≥ sm, через subgrid): шапка, заголовок, черта, пункты…, кнопка.
// Высоту каждой строки задаёт более высокая из двух карточек — черты, пункты и кнопки стоят ровно,
// а лишнее место под заголовком появляется только если он реально переносится.
const featureRows = Math.max(1, ...cards.map((card) => card.features.length));
const gridRows = featureRows + 4;
---

<section id="pricing" class="py-16 sm:py-24 md:py-32" aria-labelledby="pricing-title">
  <div class="container-page">
    <SectionTitle id="pricing-title">{t.pricing.title}</SectionTitle>

    <div
      class="mx-auto mt-12 grid max-w-[780px] gap-4 sm:grid-cols-2 sm:gap-y-0 md:mt-16 md:gap-x-6"
      style={`--pricing-rows: ${gridRows}; --pricing-feature-rows: ${featureRows}`}
    >
      {
        cards.map((card, i) => (
          <div class="pricing-cell mx-auto flex w-full max-w-[420px]" data-reveal style={`--reveal-delay: ${i * 120}ms`}>
            <article
              class="pricing-card card group relative isolate flex w-full flex-col overflow-hidden rounded-[28px] p-7 md:p-9"
              aria-labelledby={card.titleId}
              data-pricing-card
            >
              <div class="flex items-center justify-between">
                <span class="font-display text-sm font-extrabold tracking-[0.2em] text-dim" aria-hidden="true">
                  {card.index}
                </span>
                <span
                  class="flex size-[52px] items-center justify-center rounded-full border border-line bg-white/[0.04] text-white transition-[border-color,background-color] duration-500 ease-out-expo group-hover:border-line-strong group-hover:bg-white/[0.07]"
                  aria-hidden="true"
                >
                  <Icon name={card.chipIcon} size={22} />
                </span>
              </div>

              <h3
                id={card.titleId}
                class="mt-8 font-display text-[26px] leading-[1.05] font-black tracking-[-0.01em] text-balance uppercase md:text-[30px]"
              >
                {card.title}
              </h3>

              <div class="my-7 h-px bg-line" aria-hidden="true" />

              <ul class="pricing-list flex flex-1 flex-col">
                {card.features.map((f) => (
                  <li class="flex items-center gap-3.5 py-2.5">
                    <span
                      class="flex size-9 shrink-0 items-center justify-center rounded-full bg-white/[0.05] text-white"
                      aria-hidden="true"
                    >
                      <Icon name={f.icon} size={16} />
                    </span>
                    <span class="text-[15px] leading-snug text-pretty text-white/85 md:text-base">
                      {/* в одну строку, чтобы шаблон не добавил лишних пробелов вокруг числа */}
                      {f.split ? (
                        <>{f.split.before}<strong class="font-semibold whitespace-nowrap text-white">{f.split.strong}</strong>{f.split.after}</>
                      ) : (
                        f.text
                      )}
                    </span>
                  </li>
                ))}
              </ul>

              <a class="btn btn-primary mt-8 w-full" href="#contact" aria-describedby={card.titleId}>
                {t.pricing.order}
              </a>
            </article>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pricing-card {
    --mx: 50%;
    --my: 0%;
    transition:
      translate 0.6s var(--ease-out-expo),
      border-color 0.6s var(--ease-out-expo);
  }

  /* Мягкий белый отсвет за курсором (координаты --mx/--my задаёт скрипт ниже) */
  .pricing-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: radial-gradient(400px circle at var(--mx) var(--my), rgb(255 255 255 / 0.07), transparent 60%);
    opacity: 0;
    transition: opacity 0.6s var(--ease-out-expo);
    pointer-events: none;
  }

  .pricing-card:focus-within {
    border-color: var(--color-line-strong);
  }

  @media (hover: hover) and (pointer: fine) {
    .pricing-card:hover {
      border-color: var(--color-line-strong);
    }
    .pricing-card:hover::before {
      opacity: 1;
    }
  }

  /* Карточки рядом (≥ sm): обе встают на общие строки сетки через subgrid, поэтому
     черта под заголовком, пункты и кнопки выровнены, даже если заголовок или пункт
     переносится только в одной карточке. Без поддержки subgrid — обычная flex-колонка. */
  @supports (grid-template-rows: subgrid) {
    @media (min-width: 40rem) {
      .pricing-cell,
      .pricing-card,
      .pricing-list {
        display: grid;
        grid-template-rows: subgrid;
        row-gap: 0;
      }
      .pricing-cell {
        grid-row: span var(--pricing-rows);
      }
      .pricing-card {
        grid-row: 1 / -1;
      }
      .pricing-list {
        grid-row: span var(--pricing-feature-rows);
      }
    }
  }

  /* Подъём — только если пользователь не просил меньше движения */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .pricing-card:hover {
      translate: 0 -4px;
    }
  }
</style>

<script>
  // Отсвет следует за курсором — только на устройствах с точным указателем (мышь/перо)
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');

  document.querySelectorAll<HTMLElement>('[data-pricing-card]').forEach((card) => {
    let frame = 0;
    let x = 0;
    let y = 0;

    const apply = () => {
      frame = 0;
      card.style.setProperty('--mx', `${x}px`);
      card.style.setProperty('--my', `${y}px`);
    };

    card.addEventListener('pointermove', (e: PointerEvent) => {
      if (e.pointerType === 'touch' || !finePointer.matches) return;
      const rect = card.getBoundingClientRect();
      x = e.clientX - rect.left;
      y = e.clientY - rect.top;
      if (!frame) frame = requestAnimationFrame(apply);
    });
  });
</script>
