---
// Контакты: крупная карточка WhatsApp («самый быстрый ответ») и под ней три плитки —
// Telegram (ссылка), почта (ссылка + отдельная кнопка копирования), Discord (копирует ник).
// Копирование и всплывающее «Скопировано!» делает глобальный обработчик [data-copy] из site.ts:
// элемент получает .is-copied на 1.8 с — по нему иконка «копировать» сменяется галочкой.
import Icon from './Icon.astro';
import SectionTitle from './SectionTitle.astro';
import contacts from '../data/contacts.json';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Плитки: на мобильных — строка (иконка · текст · действие), от md — плитка (иконка сверху, действие в углу)
const tile =
  'group/card relative flex items-center gap-3.5 rounded-[20px] border border-line bg-white/[0.02] p-4 transition-[border-color,background-color] duration-500 ease-out-expo hover:border-white/25 hover:bg-white/[0.05] md:flex-col md:items-stretch md:gap-5 md:p-5';
const chip =
  'flex size-12 shrink-0 items-center justify-center rounded-full border border-line bg-white/[0.05] text-white transition-[border-color,background-color] duration-500 ease-out-expo group-hover/card:border-white/25 group-hover/card:bg-white/[0.08]';
const textBlock = 'min-w-0 flex-1';
const titleClass = 'block text-base leading-snug font-semibold text-white';
const valueBase = 'mt-0.5 block text-sm text-muted';
const valueClass = `${valueBase} truncate`;
// Почту не обрезаем многоточием: если не влезает, она переносится перед «@» (Pluxthumbnails / @gmail.com)
const emailValueClass = `${valueBase} wrap-anywhere`;
const emailAt = contacts.email.label.lastIndexOf('@');
const emailUser = emailAt > 0 ? contacts.email.label.slice(0, emailAt) : contacts.email.label;
const emailDomain = emailAt > 0 ? contacts.email.label.slice(emailAt) : '';
// Круглое действие справа (стрелка / копирование); от md — в правом верхнем углу плитки, по центру иконки слева
const action =
  'grid size-10 shrink-0 place-items-center rounded-full text-dim transition-[color,background-color] duration-500 ease-out-expo md:absolute md:top-6 md:right-4';
// Иконки «копировать» и «галочка» лежат в одной ячейке сетки и плавно сменяют друг друга
const copyIcon =
  'col-start-1 row-start-1 transition-[opacity,scale] duration-300 ease-out-expo group-[.is-copied]:scale-50 group-[.is-copied]:opacity-0 motion-reduce:transition-none';
const checkIcon =
  'col-start-1 row-start-1 scale-50 opacity-0 transition-[opacity,scale] duration-500 ease-out-expo group-[.is-copied]:scale-100 group-[.is-copied]:opacity-100 motion-reduce:transition-none';
---

<section id="contact" class="py-16 sm:py-24 md:py-32" aria-labelledby="contact-title">
  <div class="container-page">
    <SectionTitle id="contact-title">{t.contact.title}</SectionTitle>
    <p class="mx-auto mt-6 max-w-xl text-center text-lg text-pretty text-muted" data-reveal style="--reveal-delay: 80ms">
      {t.contact.subtitle}
    </p>

    <div
      class="mx-auto mt-12 max-w-[900px] rounded-[32px] border border-line bg-white/[0.02] p-2.5 md:mt-16 md:p-3"
      data-reveal
      style="--reveal-delay: 160ms"
    >
      {/* 1. WhatsApp — главный способ связи */}
      <div
        class="wa-card relative isolate overflow-hidden rounded-[24px] border border-line bg-linear-to-b from-white/[0.07] to-white/[0.02] p-7 md:flex md:items-end md:justify-between md:gap-8 md:p-10"
      >
        <span
          class="pointer-events-none absolute inset-x-10 top-0 h-px bg-linear-to-r from-transparent via-white/25 to-transparent"
          aria-hidden="true"></span>
        <span class="wa-mark pointer-events-none absolute -right-20 -bottom-24 -z-10 text-white" aria-hidden="true">
          <Icon name="whatsapp" size={220} />
        </span>

        <div class="min-w-0 md:flex-1">
          <p class="eyebrow flex items-center gap-2.5">
            <span class="size-1.5 shrink-0 rounded-full bg-white shadow-[0_0_10px_rgb(255_255_255/0.6)]" aria-hidden="true"
            ></span>
            {t.contact.fastest}
          </p>
          <h3
            id="contact-whatsapp-title"
            class="mt-4 font-display text-[26px] leading-tight font-extrabold tracking-[-0.01em] text-balance uppercase md:text-[34px]"
          >
            {t.contact.whatsapp}
          </h3>
          <p class="mt-2 text-lg text-muted tabular-nums">{contacts.whatsapp.label}</p>
        </div>

        <a
          class="group/btn btn btn-primary mt-8 w-full shrink-0 md:mt-0 md:w-auto"
          href={contacts.whatsapp.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-describedby="contact-whatsapp-title"
        >
          {t.contact.message}
          <Icon
            name="arrow-up-right"
            size={18}
            class="transition-transform duration-500 ease-out-expo motion-safe:group-hover/btn:translate-x-0.5 motion-safe:group-hover/btn:-translate-y-0.5"
          />
        </a>
      </div>

      {/* 2. Остальные способы. grid-cols-1 = minmax(0,1fr): колонка сжимается уже текста,
          поэтому на узких экранах плитки не вылезают за рамку */}
      <div class="mt-2.5 grid grid-cols-1 gap-2.5 md:mt-3 md:grid-cols-3 md:gap-3">
        {/* Telegram: вся плитка — ссылка */}
        <a class={tile} href={contacts.telegram.url} target="_blank" rel="noopener noreferrer">
          <span class={chip} aria-hidden="true">
            <Icon name="telegram" size={20} />
          </span>
          <span class={textBlock}>
            <span class={titleClass}>{t.contact.telegram}</span>
            <span class={valueClass}>{contacts.telegram.label}</span>
          </span>
          <span class:list={[action, 'group-hover/card:bg-white/[0.06] group-hover/card:text-white']} aria-hidden="true">
            <Icon
              name="arrow-up-right"
              size={18}
              class="transition-transform duration-500 ease-out-expo motion-safe:group-hover/card:translate-x-0.5 motion-safe:group-hover/card:-translate-y-0.5"
            />
          </span>
        </a>

        {/* Почта: ссылка mailto растянута на всю плитку, кнопка копирования — поверх
            (её ::before невидимо расширяет зону нажатия до 44×44, не меняя вида) */}
        <div class={tile}>
          <a
            class="flex min-w-0 flex-1 items-center gap-3.5 after:absolute after:inset-0 md:flex-col md:items-stretch md:gap-5"
            href={contacts.email.url}
          >
            <span class={chip} aria-hidden="true">
              <Icon name="mail" size={20} />
            </span>
            <span class={textBlock}>
              <span class={titleClass}>{t.contact.email}</span>
              <span class={emailValueClass}>{emailUser}<wbr />{emailDomain}</span>
            </span>
          </a>
          <button
            type="button"
            class:list={[
              action,
              'group relative z-10 cursor-pointer before:absolute before:-inset-0.5 hover:bg-white/[0.08] hover:text-white [&.is-copied]:text-white',
            ]}
            data-copy={contacts.email.label}
            data-copied-label={`${t.contact.copied} ${contacts.email.label}`}
            aria-label={`${t.contact.copy} ${contacts.email.label}`}
            title={t.contact.copy}
          >
            <Icon name="copy" size={17} class={copyIcon} />
            <Icon name="check" size={18} class={checkIcon} />
          </button>
        </div>

        {/* Discord: вся плитка — кнопка копирования ника */}
        <button
          type="button"
          class:list={[tile, 'group w-full cursor-pointer text-left']}
          data-copy={contacts.discord.label}
          data-copied-label={`${t.contact.copied} ${contacts.discord.label}`}
          aria-label={`${t.contact.discord}: ${contacts.discord.label} (${t.contact.copy})`}
        >
          <span class={chip} aria-hidden="true">
            <Icon name="discord" size={20} />
          </span>
          <span class={textBlock}>
            <span class={titleClass}>{t.contact.discord}</span>
            <span class={valueClass}>{contacts.discord.label}</span>
          </span>
          <span
            class:list={[
              action,
              'group-hover/card:bg-white/[0.06] group-hover/card:text-white group-[.is-copied]:text-white',
            ]}
            aria-hidden="true"
          >
            <Icon name="copy" size={17} class={copyIcon} />
            <Icon name="check" size={18} class={checkIcon} />
          </span>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  /* Карточка WhatsApp: при наведении светлеет рамка, появляется мягкий белый отсвет */
  .wa-card {
    transition:
      border-color 0.7s var(--ease-out-expo),
      box-shadow 0.7s var(--ease-out-expo);
  }
  .wa-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: radial-gradient(120% 100% at 0% 0%, rgb(255 255 255 / 0.07), transparent 55%);
    opacity: 0;
    transition: opacity 0.7s var(--ease-out-expo);
    pointer-events: none;
  }

  /* Крупный логотип WhatsApp на фоне — едва заметный, повёрнут */
  .wa-mark {
    opacity: 0.04;
    rotate: -12deg;
    transition:
      opacity 0.7s ease,
      rotate 1.2s var(--ease-out-expo),
      scale 1.2s var(--ease-out-expo);
  }

  .wa-card:focus-within {
    border-color: var(--color-line-strong);
  }
  .wa-card:focus-within::before {
    opacity: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .wa-card:hover {
      border-color: rgb(255 255 255 / 0.2);
      box-shadow: 0 0 80px -28px rgb(255 255 255 / 0.28);
    }
    .wa-card:hover::before {
      opacity: 1;
    }
    .wa-card:hover .wa-mark {
      opacity: 0.06;
    }
  }

  /* Поворот логотипа — только если пользователь не просил меньше движения */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .wa-card:hover .wa-mark {
      rotate: -6deg;
      scale: 1.05;
    }
  }
</style>
