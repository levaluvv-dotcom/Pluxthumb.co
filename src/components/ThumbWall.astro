---
// Стена работ (#examples): три бесконечные ленты превью + лайтбокс на нативном <dialog>.
// Каждая плитка — кнопка: открывает крупную версию (1920×1080 webp, готовится при сборке).
// В лайтбоксе: стрелки ←/→, свайп, Esc / клик по фону — закрыть, счётчик «07 / 27».
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { thumbRows } from '../lib/thumbs';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const rows = thumbRows();
// Номер первого превью каждого ряда в общем списке (ряд 1 → ряд 2 → ряд 3)
const offsets = rows.map((_, r) => rows.slice(0, r).reduce((sum, row) => sum + row.length, 0));
const flat = rows.flat();
const total = flat.length;

// Крупные версии для лайтбокса: 16:9 (thumb-24 обрезается по центру, как на стене), webp
const large = await Promise.all(
  flat.map(async (thumb) => {
    const img = await getImage({
      src: thumb.src,
      width: 1920,
      height: 1080,
      fit: 'cover',
      format: 'webp',
      quality: 85,
    });
    return {
      src: img.src,
      width: Number(img.attributes.width) || 1920,
      height: Number(img.attributes.height) || 1080,
    };
  }),
);
// JSON внутри <script>: экранируем «<», чтобы ничто не закрыло тег раньше времени
const lightboxJson = JSON.stringify(large).replace(/</g, '\\u003c');

// Скорость и сдвиг старта у каждого ряда свои — ленты не «шагают» синхронно
const durations = [60, 65, 58];
const delays = [0, 21, 9];

const pad = (n: number) => String(n).padStart(2, '0');

const itemClass = [
  'group relative isolate mr-3 block aspect-video w-[260px] shrink-0 cursor-zoom-in overflow-hidden',
  'rounded-[14px] border border-line bg-surface-2',
  'transition-[border-color] duration-500 ease-out-expo hover:border-white/30 focus-visible:border-white/40',
  'sm:w-[340px] md:mr-4 md:w-[440px] md:rounded-[18px]',
  // Едва заметная внутренняя подсветка при наведении (поверх картинки)
  'after:pointer-events-none after:absolute after:inset-0 after:rounded-[inherit] after:opacity-0',
  'after:shadow-[inset_0_0_0_1px_rgb(255_255_255/0.06),inset_0_0_44px_rgb(255_255_255/0.08)]',
  'after:transition-opacity after:duration-500 hover:after:opacity-100 focus-visible:after:opacity-100',
].join(' ');

const controlClass =
  'grid size-12 cursor-pointer place-items-center rounded-full border border-white/15 bg-white/[0.06] text-white transition-[background-color,border-color,scale] duration-300 ease-out-quart hover:border-white/40 hover:bg-white/[0.12] active:scale-95';
---

<section id="examples" data-thumbwall aria-label={t.nav.examples} class="relative overflow-x-clip py-16 md:py-24">
  <div class="container-page mb-10 flex items-center justify-center gap-4 md:mb-14" data-reveal>
    <span class="h-px w-8 shrink-0 bg-linear-to-r from-transparent to-white/30 md:w-14" aria-hidden="true"></span>
    <p class="eyebrow -mr-[0.24em] text-center">{t.wall.trusted}</p>
    <span class="h-px w-8 shrink-0 bg-linear-to-l from-transparent to-white/30 md:w-14" aria-hidden="true"></span>
  </div>

  {/* py-1.5 у каждого ряда — место под обводку фокуса (иначе её срежет overflow-hidden);
      -my-1.5 у обёртки компенсирует крайние отступы. Видимый зазор между рядами: 12px / 16px (md). */}
  <div class="-my-1.5">
    {
      rows.map((row, r) => (
        <div
          data-marquee
          data-reveal="fade"
          class:list={['marquee-fade overflow-hidden py-1.5', r > 0 && 'md:mt-1']}
          style={`--reveal-delay: ${r * 120}ms`}
        >
          <div
            data-marquee-track
            data-direction={r === 1 ? 'right' : 'left'}
            style={`--marquee-duration: ${durations[r % durations.length]}s; animation-delay: -${delays[r % delays.length]}s`}
          >
            {[false, true].map((clone) => (
              <div class="flex" data-marquee-clone={clone ? '' : undefined} aria-hidden={clone ? 'true' : undefined}>
                {row.map((thumb, i) => (
                  <button
                    type="button"
                    class={itemClass}
                    data-index={offsets[r] + i}
                    aria-label={`${t.wall.open} ${offsets[r] + i + 1}`}
                    tabindex={clone ? -1 : undefined}
                  >
                    <Image
                      src={thumb.src}
                      alt={t.wall.alt}
                      width={900}
                      widths={[320, 480, 640, 900]}
                      sizes="(min-width: 768px) 440px, (min-width: 640px) 340px, 260px"
                      class="h-full w-full object-cover transition-transform duration-700 ease-out-expo group-hover:scale-[1.05]"
                      loading={r === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                      draggable="false"
                    />
                  </button>
                ))}
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>

  <script is:inline type="application/json" id="thumbwall-data" data-thumbwall-data set:html={lightboxJson} />

  <dialog
    data-lb
    data-lenis-prevent
    aria-label={t.nav.examples}
    class="lb fixed inset-0 m-0 size-full max-h-none max-w-none overflow-hidden overscroll-contain border-0 bg-transparent p-0 text-fg outline-none"
  >
    <div
      data-lb-stage
      class="relative grid size-full cursor-zoom-out touch-pan-y touch-pinch-zoom place-items-center select-none"
    >
      <button
        type="button"
        data-lb-action="close"
        class:list={[controlClass, 'absolute right-4 top-[max(1rem,env(safe-area-inset-top))] md:right-6 md:top-6']}
        aria-label={t.wall.close}
      >
        <Icon name="close" size={20} />
      </button>

      <div
        data-lb-frame
        class="lb-frame relative cursor-default overflow-hidden rounded-[14px] bg-surface-2 ring-1 ring-white/10 md:rounded-[18px]"
      >
        <img data-lb-img alt={t.wall.alt} hidden draggable="false" decoding="async" class="absolute inset-0 size-full object-cover" />
      </div>

      <button
        type="button"
        data-lb-action="prev"
        class:list={[
          controlClass,
          'absolute bottom-[max(1.25rem,env(safe-area-inset-bottom))] left-4 md:bottom-auto md:left-6 md:top-1/2 md:-translate-y-1/2',
        ]}
        aria-label={t.wall.prev}
      >
        <Icon name="chevron-left" size={22} />
      </button>
      <button
        type="button"
        data-lb-action="next"
        class:list={[
          controlClass,
          'absolute bottom-[max(1.25rem,env(safe-area-inset-bottom))] right-4 md:bottom-auto md:right-6 md:top-1/2 md:-translate-y-1/2',
        ]}
        aria-label={t.wall.next}
      >
        <Icon name="chevron-right" size={22} />
      </button>

      <p
        class="pointer-events-none absolute bottom-[max(1.25rem,env(safe-area-inset-bottom))] left-1/2 h-12 -translate-x-1/2 whitespace-nowrap font-display text-sm leading-[3rem] font-extrabold tracking-[0.14em] tabular-nums md:bottom-6"
        aria-live="polite"
        aria-atomic="true"
      >
        <span data-lb-current>01</span> <span class="text-dim">/</span> <span class="text-muted">{pad(total)}</span>
      </p>
    </div>
  </dialog>
</section>

<style>
  /* Лайтбокс: открытие — плавное проявление фона и картинки (0.45s expo-out, scale 0.96 → 1),
     закрытие — быстрее (0.28s). Класс .is-open ставит скрипт. Кривые записаны явно:
     ::backdrop в старых браузерах не наследует CSS-переменные. */
  .lb {
    opacity: 0;
    transition: opacity 0.28s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .lb::backdrop {
    background: rgb(0 0 0 / 0.85);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    opacity: 0;
    transition: opacity 0.28s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .lb.is-open,
  .lb.is-open::backdrop {
    opacity: 1;
    transition-duration: 0.45s;
    transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Рамка картинки: размер считается от пропорций (--ar), чтобы превью-заглушка
     и крупный файл занимали одно и то же место. Не больше 92vw / 1600px / 82vh. */
  .lb-frame {
    --ar: 1.7778;
    width: min(92vw, 1600px, calc(min(82vh, 100vh - 168px) * var(--ar)));
    aspect-ratio: var(--ar);
    transform: scale(0.96);
    transition: transform 0.28s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .lb.is-open .lb-frame {
    transform: none;
    transition-duration: 0.45s;
    transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (min-width: 768px) {
    .lb-frame {
      /* по бокам — место под стрелки */
      width: min(100vw - 192px, 1600px, calc(min(82vh, 100vh - 168px) * var(--ar)));
    }
  }

  /* Пока лайтбокс открыт, ленты под размытым фоном стоят — не тратим GPU */
  [data-thumbwall][data-lb-open] [data-marquee-track] {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .lb,
    .lb::backdrop,
    .lb-frame {
      transition: none;
    }
    .lb-frame {
      transform: none;
    }
  }
</style>

<script>
  type LightboxItem = { src: string; width: number; height: number };
  type Preloaded = { img: HTMLImageElement; done: boolean; ready: Promise<void> };
  type Direction = -1 | 0 | 1;

  const EASE_OUT_EXPO = 'cubic-bezier(0.16, 1, 0.3, 1)';
  const OPEN_MS = 450;
  const CLOSE_MS = 280;
  const SWIPE_PX = 40;

  const prefersReducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const pad = (n: number) => String(n).padStart(2, '0');

  function initThumbWall(section: HTMLElement) {
    const dataEl = section.querySelector<HTMLScriptElement>('script[data-thumbwall-data]');
    const dialog = section.querySelector<HTMLDialogElement>('dialog[data-lb]');
    if (!dataEl || !dialog || typeof dialog.showModal !== 'function') return;
    const stage = dialog.querySelector<HTMLElement>('[data-lb-stage]');
    const frame = dialog.querySelector<HTMLElement>('[data-lb-frame]');
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]');
    const current = dialog.querySelector<HTMLElement>('[data-lb-current]');
    if (!stage || !frame || !img || !current) return;

    let items: LightboxItem[] = [];
    try {
      const parsed: unknown = JSON.parse(dataEl.textContent || '[]');
      if (Array.isArray(parsed)) items = parsed as LightboxItem[];
    } catch {
      return;
    }
    const count = items.length;
    if (!count) return;

    const roots = Array.from(section.querySelectorAll<HTMLElement>('[data-marquee]'));
    const wrap = (i: number) => ((i % count) + count) % count;

    let index = 0;
    let token = 0; // растёт при каждой смене картинки — отменяет «запоздавшие» загрузки
    let isOpen = false;
    let closing = false;
    let closeTimer = 0;
    let pauseTimer = 0;
    let opener: HTMLButtonElement | null = null;
    let savedScroll: number[] = [];
    let navAnim: Animation | null = null;

    /* ---------- Предзагрузка крупных версий ---------- */
    const cache = new Map<string, Preloaded>();
    const preload = (i: number): Preloaded => {
      const { src } = items[wrap(i)];
      const cached = cache.get(src);
      if (cached) return cached;
      const el = new Image();
      el.decoding = 'async';
      el.src = src;
      const entry: Preloaded = { img: el, done: false, ready: Promise.resolve() };
      entry.ready = el.decode().then(
        () => {
          entry.done = true;
        },
        () => {
          /* не загрузилось — покажем как есть, браузер попробует сам */
        },
      );
      cache.set(src, entry);
      return entry;
    };

    // Уже загруженная миниатюра со стены — мгновенная заглушка, пока грузится крупный файл
    const placeholder = (i: number) => {
      const thumb = section.querySelector<HTMLImageElement>(`button[data-index="${i}"] img`);
      return thumb && thumb.complete && thumb.naturalWidth > 0 ? thumb.currentSrc || thumb.src : '';
    };

    /* ---------- Показ картинки ---------- */
    const show = (i: number, dir: Direction) => {
      index = wrap(i);
      const item = items[index];
      const id = ++token;
      current.textContent = pad(index + 1);
      frame.style.setProperty('--ar', String(item.width / item.height));

      const entry = preload(index);
      const instant = entry.done ? item.src : placeholder(index);
      if (instant) {
        img.src = instant;
        img.hidden = false;
      } else {
        img.hidden = true;
        img.removeAttribute('src');
      }
      if (!entry.done) {
        void entry.ready.then(() => {
          if (id !== token) return;
          const reveal = img.hidden;
          img.src = item.src;
          img.hidden = false;
          if (reveal && !prefersReducedMotion()) {
            img.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 400, easing: EASE_OUT_EXPO });
          }
        });
      }

      if (dir !== 0 && !prefersReducedMotion()) {
        navAnim?.cancel();
        navAnim = frame.animate(
          [
            { opacity: 0, transform: `translate3d(${dir * 36}px, 0, 0) scale(0.985)` },
            { opacity: 1, transform: 'none' },
          ],
          { duration: OPEN_MS, easing: EASE_OUT_EXPO },
        );
      }

      preload(index + 1);
      preload(index - 1);
    };

    // Ленты под фоном останавливаем, когда лайтбокс уже открылся, и запускаем в начале закрытия
    const setRowsPaused = (paused: boolean) => {
      window.clearTimeout(pauseTimer);
      if (paused) {
        pauseTimer = window.setTimeout(() => {
          if (isOpen && !closing) section.setAttribute('data-lb-open', '');
        }, OPEN_MS);
      } else {
        section.removeAttribute('data-lb-open');
      }
    };

    /* ---------- Открытие / закрытие ---------- */
    const openAt = (i: number, from: HTMLButtonElement) => {
      if (isOpen) return;
      savedScroll = roots.map((root) => root.scrollLeft);
      try {
        dialog.showModal();
      } catch {
        return;
      }
      isOpen = true;
      closing = false;
      opener = from;
      document.dispatchEvent(new Event('scroll:lock'));
      show(i, 0);
      void dialog.offsetWidth; // зафиксировать начальное состояние, чтобы сработал переход
      dialog.classList.add('is-open');
      setRowsPaused(true);
    };

    const requestClose = () => {
      if (!isOpen || closing) return;
      if (prefersReducedMotion()) {
        dialog.close();
        return;
      }
      closing = true;
      setRowsPaused(false);
      dialog.classList.remove('is-open');
      closeTimer = window.setTimeout(() => dialog.close(), CLOSE_MS);
    };

    // Срабатывает при любом закрытии (кнопка, фон, Esc)
    dialog.addEventListener('close', () => {
      window.clearTimeout(closeTimer);
      setRowsPaused(false);
      dialog.classList.remove('is-open');
      closing = false;
      if (!isOpen) return;
      isOpen = false;
      token++;
      navAnim?.cancel();
      navAnim = null;
      document.dispatchEvent(new Event('scroll:unlock'));

      // Фокус — обратно на плитку, с которой открыли (у дубля ленты — никуда).
      // Если фокус «невидимый» (закрыли мышью/тачем) — снимаем его: site.ts останавливает
      // ленту на focusin, и без этого ряд замер бы до следующего клика.
      const from = opener;
      opener = null;
      if (from && from.isConnected) {
        if (from.closest('[data-marquee-clone]')) {
          if (document.activeElement === from) from.blur();
        } else {
          from.focus({ preventScroll: true });
          let visible = true;
          try {
            visible = from.matches(':focus-visible');
          } catch {
            /* браузер без :focus-visible — оставляем фокус */
          }
          if (!visible) from.blur();
        }
      }
      // Возврат фокуса мог прокрутить ленту (overflow-hidden) — вернуть как было
      roots.forEach((root, i) => {
        root.scrollLeft = savedScroll[i] ?? 0;
      });
    });

    // Esc: вместо мгновенного закрытия — плавное
    dialog.addEventListener('cancel', (e) => {
      if (!e.cancelable || prefersReducedMotion()) return;
      e.preventDefault();
      requestClose();
    });

    /* ---------- Управление ---------- */
    dialog.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault();
      const dir = e.key === 'ArrowRight' ? 1 : -1;
      show(index + dir, dir);
    });

    // Свайп влево/вправо (палец или мышь)
    let startX = 0;
    let startY = 0;
    let pointerId: number | null = null;
    let swipedAt = -Infinity;
    stage.addEventListener('pointerdown', (e) => {
      if (!e.isPrimary || (e.pointerType === 'mouse' && e.button !== 0)) return;
      pointerId = e.pointerId;
      startX = e.clientX;
      startY = e.clientY;
    });
    stage.addEventListener('pointerup', (e) => {
      if (e.pointerId !== pointerId) return;
      pointerId = null;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (Math.abs(dx) < SWIPE_PX || Math.abs(dx) < Math.abs(dy) * 1.2) return;
      swipedAt = performance.now();
      const dir = dx < 0 ? 1 : -1;
      show(index + dir, dir);
    });
    stage.addEventListener('pointercancel', () => {
      pointerId = null;
    });

    // Кнопки + клик по фону (мимо картинки и кнопок) закрывает
    dialog.addEventListener('click', (e) => {
      if (performance.now() - swipedAt < 400) return; // клик, которым закончился свайп
      const target = e.target instanceof Element ? e.target : null;
      const action = target?.closest<HTMLElement>('[data-lb-action]')?.dataset.lbAction;
      if (action === 'prev') show(index - 1, -1);
      else if (action === 'next') show(index + 1, 1);
      else if (action === 'close' || !target?.closest('[data-lb-frame]')) requestClose();
    });

    // Клик по плитке на стене (оригинал или дубль ленты)
    section.addEventListener('click', (e) => {
      const target = e.target instanceof Element ? e.target : null;
      const btn = target?.closest<HTMLButtonElement>('button[data-index]');
      if (!btn || dialog.contains(btn)) return;
      const i = Number(btn.dataset.index);
      if (Number.isInteger(i)) openAt(i, btn);
    });

    /* ---------- Ленивые ряды ---------- */
    // Ряды 2–3 грузятся лениво; когда стена близко — догружаем их целиком, чтобы плитки,
    // скрытые за краем ленты, не «проявлялись» уже на виду.
    const lazyImgs = section.querySelectorAll<HTMLImageElement>('img[loading="lazy"]');
    if (lazyImgs.length && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          io.disconnect();
          lazyImgs.forEach((el) => {
            el.loading = 'eager';
          });
        },
        { rootMargin: '200px 0px' },
      );
      io.observe(section);
    }
  }

  document.querySelectorAll<HTMLElement>('[data-thumbwall]').forEach(initThumbWall);
</script>
